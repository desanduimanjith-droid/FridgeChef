{
  "private": true,
  "name": "fridgechef-root",
  "scripts": {
    "build": "npm run build --prefix frontend && node -e \"const fs=require('fs');fs.rmSync('.next',{recursive:true,force:true});fs.cpSync('frontend/.next','.next',{recursive:true});\"",
    "dev": "npm run dev --prefix frontend",
    "start": "npm run start --prefix frontend"
  },
  "dependencies": {
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}